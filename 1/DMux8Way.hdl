// File name: projects/1/DMux8Way.hdl
/**
 * 8-way demultiplexor:
 * [a, b, c, d, e, f, g, h] = [in, 0,  0,  0,  0,  0,  0,  0] if sel = 000
 *                            [0, in,  0,  0,  0,  0,  0,  0] if sel = 001
 *                            [0,  0, in,  0,  0,  0,  0,  0] if sel = 010
 *                            [0,  0,  0, in,  0,  0,  0,  0] if sel = 011
 *                            [0,  0,  0,  0, in,  0,  0,  0] if sel = 100
 *                            [0,  0,  0,  0,  0, in,  0,  0] if sel = 101
 *                            [0,  0,  0,  0,  0,  0, in,  0] if sel = 110
 *                            [0,  0,  0,  0,  0,  0,  0, in] if sel = 111
 */
CHIP DMux8Way {
    IN in, sel[3]; // 3 selector bits; 2^3=8 inputs
    OUT a, b, c, d, e, f, g, h;

    PARTS:
    DMux(in=in, sel=sel[2], a=abcd, b=efgh); //1-bit demux, uses sel[2] to choose between the first 4 outputs and the last 4 outputs
    DMux4Way(in=abcd, sel=sel[0..1], a=a, b=b, c=c, d=d); //2-way demux, uses sel[0..1] to choose between the first 4 outputs
    DMux4Way(in=efgh, sel=sel[0..1], a=e, b=f, c=g, d=h);  //2-way demux, uses sel[0..1] to choose between the last 4 outputs
}
