// File name: projects/1/Mux4Way16.hdl
/**
 * 4-way 16-bit multiplexor:
 * out = a if sel = 00
 *       b if sel = 01
 *       c if sel = 10
 *       d if sel = 11
 */
CHIP Mux4Way16 {
    IN a[16], b[16], c[16], d[16], sel[2];
    OUT out[16];
    
    PARTS:
    Mux16(a=a, b=b, sel=sel[0], out=ab); //chooses between a and b
    Mux16(a=c, b=d, sel=sel[0], out=cd); //chooses between c and d
    Mux16(a=ab, b=cd, sel=sel[1], out=out); //uses sel{1} to choose between the two previous outputs
//sel[1]=0: out=ab, sel[1]=1: out=cd, sel[0]=0: ab=a, cd=c, sel[0]=1: ab=b, cd=d
}