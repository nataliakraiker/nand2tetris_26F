// File name: projects/1/DMux.hdl
/**
 * Demultiplexor:
 * [a, b] = [in, 0] if sel = 0
 *          [0, in] if sel = 1
 */
CHIP DMux {
    IN in, sel;
    OUT a, b;

    PARTS:
    //rule: sel=0, a=in, b=0; sel=1, a=0, b=in
    Not(in=sel, out=notsel); // invert selector
    And(a=in, b=notsel, out=a); // a = in * notsel
    And(a=in, b=sel, out=b); // b = in * sel
}
