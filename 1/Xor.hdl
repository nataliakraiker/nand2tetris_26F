// File name: projects/1/Xor.hdl
/**
 * Exclusive-or gate:
 * if ((a and Not(b)) or (Not(a) and b)) out = 1, else out = 0
 */
CHIP Xor {
    IN a, b;
    OUT out;

    PARTS:
    //(a and NOT(b) OR (NOT(a) and b))
    Not(in=a, out=notA); //nota
    Not(in=b, out=notB); //notb
    And(a=a, b=notB, out=and1); //and1 = a * notb
    And(a=notA, b=b, out=and2); //and2 = nota * b
    Or(a=and1, b=and2, out=out); // out = and1 + and2 = (a * notb) + (nota * b)
}