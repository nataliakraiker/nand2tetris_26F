// File name: projects/1/Mux.hdl
/** 
 * Multiplexor:
 * if (sel = 0) out = a, else out = b
 */
CHIP Mux {
    IN a, b, sel;
    OUT out;

    PARTS:
    //rule: if sel=0, out=a; else out=b
    Not(in=sel, out=notsel); //invert selector
    And(a=a, b=notsel, out=and1); //and1 = a * notsel
    And(a=b, b=sel, out=and2); //and2 = b * sel
    Or(a=and1, b=and2, out=out); // out = and1 + and2 = (a * notsel) + (b * sel)
}