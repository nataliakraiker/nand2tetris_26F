// File name: projects/1/Mux8Way16.hdl
/**
 * 8-way 16-bit multiplexor:
 * out = a if sel = 000
 *       b if sel = 001
 *       c if sel = 010
 *       d if sel = 011
 *       e if sel = 100
 *       f if sel = 101
 *       g if sel = 110
 *       h if sel = 111
 */
CHIP Mux8Way16 {
    IN a[16], b[16], c[16], d[16],
       e[16], f[16], g[16], h[16],
       sel[3];
    OUT out[16];

    PARTS:
    //eight 16-bit inputs, one 3 bit selector: sel[3], one 16 bit output: out[16]
    Mux4Way16(a=a, b=b, c=c, d=d, sel=sel[0..1], out=abcd); //uses sel[0..1] to choose between the first 4 inputs
    Mux4Way16(a=e, b=f, c=g, d=h, sel=sel[0..1], out=efgh); //uses sel[0..1] to choose between the last 4 inputs
    Mux16(a=abcd, b=efgh, sel=sel[2], out=out); //uses sel[2] to choose between the outputs of the two 4-way muxes
    //sel[2]=0: out=abcd, sel[2]=1: out=efgh, sel[0..1]=00: abcd=a, efgh=e, sel[0..1]=01: abcd=b, efgh=f, sel[0..1]=10: abcd=c, efgh=g, sel[0..1]=11: abcd=d, efgh=h  
}
