// File name: projects/2/FullAdder.hdl
/**
 * Computes the sum of three bits.
 */
CHIP FullAdder {
    IN a, b, c;  // 1-bit inputs
    OUT sum,     // Right bit of a + b + c
        carry;   // Left bit of a + b + c

    PARTS:
    //Add a and b. sum1= a XOR b, carry1= a AND b
    HalfAdder(a=a, b=b, sum=abSum, carry=abCarry);
    //Add incoming carry to sum1 for final sum
    HalfAdder(a=abSum, b=c, sum=sum, carry=carry2);
    //combine carry possibilities
    Or(a=abCarry, b=carry2, out=carry);
}